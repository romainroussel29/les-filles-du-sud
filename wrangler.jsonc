// Configuration Cloudflare Workers : publie le site compilé (dossier dist) en ressources statiques.
// Build command à définir dans Cloudflare : npm run build
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "les-filles-du-sud",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Toutes les URL renvoient vers index.html (application React à page unique)
    "not_found_handling": "single-page-application"
  }
}
